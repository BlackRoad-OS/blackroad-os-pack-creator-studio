{
  "name": "blackroad-os-pack-creator-studio",
  "version": "1.0.0",
  "description": "BlackRoad OS Pack Creator Studio - A service for creating and managing OS packs",
  "private": true,
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --import tsx --no-warnings src/index.js",
    "start:studio": "node --import tsx --no-warnings src/index.js",
    "dev": "nodemon --exec 'node --import tsx --no-warnings' src/index.js",
    "br-create": "node --import tsx --no-warnings src/cli.ts",
    "lint": "eslint ./src ./agents ./lib ./scripts --ext .ts && prettier -c .",
    "format": "prettier -w .",
    "postbuild": "node --import tsx --no-warnings scripts/postbuild.ts",
    "test": "npm run test:ts && npm run test:py",
    "test:ts": "mocha tests/**/*.test.ts",
    "test:py": "python -m pytest tests/ -v"
  },
  "keywords": [
    "blackroad",
    "os",
    "pack",
    "creator",
    "studio"
  ],
  "author": "BlackRoad OS Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.19.15",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^10.7.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
